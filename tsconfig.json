{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./backend/node_modules/@types", "./frontend/node_modules/@types"]
  },
  "include": ["evals/**/*", "backend/src/**/*"],
  "exclude": ["node_modules", "backend/dist", "frontend/.next"]
}
