{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauta.local/contracts/json-render/reconciliation-findings",
  "title": "ReconciliationFindingsProps",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "severity", "discrepancies", "evidenceIds"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["matched", "discrepancy"]
    },
    "severity": {
      "type": "string",
      "enum": ["normal", "warning", "critical"]
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "severity", "values"],
        "properties": {
          "field": {
            "type": "string",
            "enum": ["containerNumber", "weightKg", "amountUsd"]
          },
          "severity": {
            "type": "string",
            "enum": ["warning", "critical"]
          },
          "values": {
            "type": "object",
            "additionalProperties": false,
            "required": ["billOfLading", "commercialInvoice", "packingList"],
            "properties": {
              "billOfLading": {
                "type": ["string", "number"]
              },
              "commercialInvoice": {
                "type": ["string", "number"]
              },
              "packingList": {
                "type": ["string", "number"]
              }
            }
          }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
