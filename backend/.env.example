PORT=3001
FRONTEND_URL=http://localhost:3000

# Required for the dashboard chat tracer.
OPENAI_API_KEY=
OPENAI_MAIN_MODEL=gpt-5.6-luna
OPENAI_SMALL_MODEL=gpt-5.6-luna

# E2B custom-report tracer. The API key is server-only.
E2B_API_KEY=
E2B_REPORT_TEMPLATE=nauta-report-builder-v1

# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
