PORT=3001
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://maizena-nextwave-frontend.onrender.com,https://maizena-nextwave.onrender.com,https://maizena-nextwave.vercel.app,https://maizena-nextwave-git-main-joshuapzzs-projects.vercel.app
BACKEND_PUBLIC_URL=http://localhost:3001

# Required for the dashboard chat tracer.
OPENAI_API_KEY=
OPENAI_MAIN_MODEL=gpt-5.6-luna
OPENAI_SMALL_MODEL=gpt-5.6-luna
# Optional dedicated model for multi-file custom-report authoring. Falls back to
# OPENAI_MODEL_REASONING (legacy) and then OPENAI_MAIN_MODEL.
OPENAI_REPORT_MODEL=gpt-5.6-luna

# E2B custom-report tracer. The API key is server-only.
E2B_API_KEY=
E2B_REPORT_TEMPLATE=nauta-report-builder-v1
REPORT_DEMO_SOURCE_REFERENCE=OP-2026-101
# Process-wide paid generation ceiling. Valid range: 1..4; safe default: 1.
REPORT_GENERATION_MAX_CONCURRENCY=1

# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORT_ARTIFACTS_BUCKET=report-artifacts
